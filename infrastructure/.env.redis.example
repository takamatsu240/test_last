# Redis環境変数サンプル
# ⚠️ このファイルを .env にコピーして、実際の値に置き換えてください
# ⚠️ .env ファイルは .gitignore に含まれており、Gitにコミットされません

# ========================================
# Redis接続情報
# ========================================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ⚠️ 必須: 強力なパスワードを設定してください（32文字以上推奨）
# 生成例: openssl rand -base64 32
REDIS_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# ========================================
# Docker Compose用
# ========================================

# Redis Commander管理画面のパスワード
REDIS_COMMANDER_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# ========================================
# セッション設定
# ========================================

# セッション有効期限（秒）
SESSION_TTL=3600

# ========================================
# キャッシュ設定
# ========================================

# クエリキャッシュ有効期限（秒）
QUERY_CACHE_TTL=300
